# Configuración de alertas Netsubasta
# Edita este archivo para cambiar los filtros

# URL base (no suele hacer falta cambiarla)
BASE_URL=https://netsubasta.com

# Tipos de vehículo (IDs de typologies_id en netsubasta.com)
# 10 = Motos y scooters
# 13 = Turismos y vehículos comerciales
TIPOS=10,13

# Estados permitidos (sources_id). Nombres como aparecen en la web.
# 13=Averiado, 15=Con daños internos, 6=Con daños exteriores, 17=Falta de uso, 7=Sin daños
ESTADOS=Averiado,Con daños internos,Con daños exteriores,Falta de uso,Sin daños

# Ubicaciones permitidas (nombres de provincia como en el listado)
UBICACIONES=León,Zamora,Salamanca,Valladolid,Palencia,Ávila,Burgos,Asturias,Madrid,Cantabria

# Archivo donde se guardan los IDs ya vistos
SEEN_FILE=data/seen_ids.json

# Pausa entre peticiones de detalle (segundos) para no saturar el servidor
DETAIL_DELAY=0.5

# Obtener descripción/comentarios de la ficha (petición extra por vehículo nuevo)
FETCH_DETAILS=true
